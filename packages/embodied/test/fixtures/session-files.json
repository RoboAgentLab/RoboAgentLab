{
	"about": "Cases the session-file rule must decide the same way in TypeScript (../session-files.test.ts) and Python (services/tests/test_planner_export.py): a file named `name` whose first line is `first` (or the bytes `first_base64`), then one entry line.",
	"cases": [
		{
			"name": "2026-01-01T00-00-00-000Z_0198f2a1-7c3e-7f00-8000-000000000001.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"0198f2a1-7c3e-7f00-8000-000000000001\",\"cwd\":\"/\"}",
			"session": true,
			"why": "pi's own: a uuid"
		},
		{
			"name": "2026-01-01T00-00-00-001Z_my.id_2.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"my.id_2\",\"cwd\":\"/\"}",
			"session": true,
			"why": "an id given with --session-id"
		},
		{
			"name": "2026-01-01T00-00-00-002Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"b\",\"cwd\":\"/\"}",
			"session": false,
			"why": "another id in the header"
		},
		{
			"name": "2026-01-01T00-00-00-003Z_a.jsonl",
			"first": "{\"type\":\"custom\",\"id\":\"a\"}",
			"session": false,
			"why": "a header that is not a session's"
		},
		{
			"name": "2026-01-01T00-00-00-004Z_-a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"-a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "an id pi would not give (it starts with -)"
		},
		{
			"name": "2026-01-01T00-00-00-005Z_a..jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a.\",\"cwd\":\"/\"}",
			"session": false,
			"why": "an id pi would not give (it ends with .)"
		},
		{
			"name": "cell_2026-01-01T00-00-00-006Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "pi's name after a prefix (a cell's file)"
		},
		{
			"name": "2026-01-01T00-00-00-007Z_a.jsonl.bak",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "pi's name with more after it"
		},
		{
			"name": "2026-01-01T00-00-00-008Z_a.JSONL",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "another case"
		},
		{
			"name": "2026-01-01T00:00:00.009Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "the time as ISO writes it, not as pi names files"
		},
		{
			"name": "２０２６-01-01T00-00-00-010Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "digits that are not ASCII"
		},
		{
			"name": "2026-01-01_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "a date alone"
		},
		{
			"name": "a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "no time"
		},
		{
			"name": "2026-01-01T00-00-00-011Z_a.jsonl",
			"first": "",
			"session": false,
			"why": "the header not on the first line"
		},
		{
			"name": "2026-01-01T00-00-00-012Z_a.jsonl",
			"first": "﻿{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}",
			"session": false,
			"why": "a byte order mark before the header"
		},
		{
			"name": "2026-01-01T00-00-00-013Z_a.jsonl",
			"first": "{\"type\":\"session\",\"id\":\"a\",\"x\":NaN}",
			"session": false,
			"why": "a header that is no JSON (NaN)"
		},
		{
			"name": "2026-01-01T00-00-00-014Z_a.jsonl",
			"first": "[{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}]",
			"session": false,
			"why": "a header in a list"
		},
		{
			"name": "2026-01-01T00-00-00-015Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}\r",
			"session": true,
			"why": "a header ending its line with CR LF"
		},
		{
			"name": "2026-01-01T00-00-00-016Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\"}\rjunk",
			"session": false,
			"why": "a CR does not end the first line: junk after it"
		},
		{
			"name": "2026-01-01T00-00-00-017Z_a.jsonl",
			"first_base64": "eyJ0eXBlIjoic2Vzc2lvbiIsInZlcnNpb24iOjMsImlkIjoiYSIsImN3ZCI6Ii//In0=",
			"session": true,
			"why": "bytes that are no UTF-8 inside a header string (both read them as U+FFFD)"
		},
		{
			"name": "2026-01-01T00-00-00-018Z_a.jsonl",
			"first_base64": "eyJ0eXBlIjoic2Vzc2lvbiIsInZlcnNpb24iOjMsImlkIjoi/yIsImN3ZCI6Ii8ifQ==",
			"session": false,
			"why": "bytes that are no UTF-8 as the id"
		},
		{
			"name": "2026-01-01T00-00-00-019Z_a.jsonl",
			"first": "{\"type\":\"session\",\"version\":3,\"id\":\"a\",\"cwd\":\"/\",\"n\":}",
			"session": true,
			"why": "an integer longer than Python's int parser takes (4300 digits): read as JavaScript reads it"
		}
	]
}
